{
  "name": "spacesim-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src scripts tests",
    "test": "vitest run",
    "sim:run": "tsx scripts/sim-run.ts",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "three": "0.185.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.15.32",
    "@types/three": "0.185.4",
    "eslint": "9.39.1",
    "fake-indexeddb": "6.2.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vite": "7.3.1",
    "vitest": "3.2.4"
  }
}
